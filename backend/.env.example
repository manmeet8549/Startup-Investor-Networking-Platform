# Founders Den - Backend Environment Variables (.env.example)
# Do NOT place production secrets in this file. Copy to .env for local development.

# Server runtime mode (development, production, or test)
NODE_ENV=development

# Server port (Render sets this dynamically via PORT; default 5000 for local)
PORT=5000

# Server logging verbosity (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Allowed CORS origins as a comma-separated list of exact URLs (No wildcards)
# In production, set to your Vercel deployment URL (e.g. https://founders-den.vercel.app)
CORS_ORIGIN=http://localhost:3000

# In-memory database flag (strictly false for production; true only for offline tests)
USE_IN_MEMORY_DB=false

# Supabase Project Base URL
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous API Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Secret Service Role API Key (Server-only; full administrative access)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Supabase JWT Secret (Optional in production when verifying via Supabase Auth API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Primary PostgreSQL Connection String (Render backend connects to Supabase Session pooler)
# Format: postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Migration Connection String (Optional: direct or pooler connection string used by db:migrate)
MIGRATION_DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Optional: Automatic keep-alive ping URL for Render free tier (pings every 10 mins to prevent sleep)
KEEP_ALIVE_URL=https://startup-investor-networking-platform.onrender.com
